# Виртуальные окружения
venv/
.venv/
env/
ENV/

# Байт-код Python
__pycache__/
*.py[cod]
*$py.class

# Файлы базы данных SQLite (самое важное, чтобы не перезатирать базу)
db.sqlite3
*.sqlite3

# Локальные настройки (часто хранят SECRET_KEY, DEBUG и т.п.)
local_settings.py
.env

# IDE и редакторы
.idea/
.vscode/
*.swp
*.swo
*~

# Системные файлы
.DS_Store
Thumbs.db

# Артефакты сборки и дистрибуции
dist/
build/
*.egg-info

# Кэши и отчёты тестов
.cache/
.pytest_cache/
coverage.xml
.coverage

# Статика и медиа (если собираете их локально)
staticfiles/
media/
